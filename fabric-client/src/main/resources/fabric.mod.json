{
  "schemaVersion": 1,
  "id": "servercontrol",
  "version": "${version}",
  "name": "ServerControl Client",
  "description": "Client-side companion for the ServerControl Paper plugin.",
  "authors": [
    "ServerControl"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.servercontrol.fabric.ServerControlClient"
    ]
  },
  "mixins": [
    "servercontrol-client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
